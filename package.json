{
  "name": "geostripe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A free, browser-based editor for sketching street and intersection redesigns as real vector data (GeoJSON) on top of satellite imagery.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/colemccall/geostripe.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:domain": "tsc --noEmit && vite build --mode domain",
    "prep:pages": "node scripts/prep-pages.mjs --target pages",
    "prep:docs": "node scripts/prep-pages.mjs --target docs",
    "prep:domain": "node scripts/prep-pages.mjs --target domain",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/sync-maplibre-worker.mjs",
    "prebuild": "node scripts/sync-maplibre-worker.mjs",
    "prebuild:pages": "node scripts/sync-maplibre-worker.mjs",
    "prebuild:domain": "node scripts/sync-maplibre-worker.mjs"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "maplibre-gl": "^6.5.0",
    "polyclip-ts": "^0.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
